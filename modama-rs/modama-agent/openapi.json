{
  "openapi": "3.1.0",
  "info": {
    "title": "modama-agent local API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health/": {
      "get": {
        "operationId": "health",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIHealthCheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          },
          "503": {
            "description": "Agent is connecting and not yet available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIHealthCheckResponse"
                }
              }
            }
          }
        },
        "x-introduced-in-version": "1.0.0"
      }
    },
    "/api/identity/": {
      "get": {
        "operationId": "get_identity",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Local agent identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIAgentIdentity"
                }
              }
            }
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          }
        },
        "x-introduced-in-version": "1.0.0"
      }
    },
    "/api/login/": {
      "post": {
        "operationId": "login",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/APILoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; the session is in the `modama_agent_session` cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APILoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          },
          "401": {
            "description": "Wrong username or password"
          }
        },
        "x-introduced-in-version": "1.0.0"
      }
    },
    "/api/logout/": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out; the session cookie is removed"
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          }
        },
        "x-introduced-in-version": "1.0.0"
      }
    },
    "/api/projects/": {
      "get": {
        "operationId": "list_projects",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIListProjectsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session has ended"
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ],
        "x-introduced-in-version": "1.0.0"
      }
    },
    "/api/projects/{project_name}/sessions/": {
      "get": {
        "operationId": "list_sessions_in_project",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project_name",
            "in": "path",
            "description": "Project name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions in the project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIListSessionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session has ended"
          },
          "404": {
            "description": "Project not found"
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ],
        "x-introduced-in-version": "1.0.0"
      },
      "post": {
        "operationId": "create_session_in_project",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project_name",
            "in": "path",
            "description": "Project name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/APICreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Created session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APICreateSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session has ended"
          },
          "404": {
            "description": "Project not found"
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ],
        "x-introduced-in-version": "1.0.0"
      }
    },
    "/api/projects/{project_name}/sessions/{session_name}/start-ingest/": {
      "post": {
        "operationId": "start_ingest",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project_name",
            "in": "path",
            "description": "Project name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session_name",
            "in": "path",
            "description": "Session name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The ingest share: a new one, or the caller's existing one for this session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APICreateShareResponse"
                }
              }
            }
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session has ended"
          },
          "403": {
            "description": "Not a member of the project"
          },
          "404": {
            "description": "Project or session not found"
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ],
        "x-introduced-in-version": "1.0.0"
      }
    },
    "/api/shares/foreground/": {
      "get": {
        "summary": "Query for the foreground ingest",
        "operationId": "get_foreground_share",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The foreground ingest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APICurrentForegroundShare"
                }
              }
            }
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          }
        },
        "x-introduced-in-version": "1.0.0"
      }
    },
    "/api/shares/{share_id}/": {
      "delete": {
        "operationId": "delete_share",
        "parameters": [
          {
            "name": "X-API-Version",
            "in": "header",
            "description": "API version",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "share_id",
            "in": "path",
            "description": "Ingest share identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Ingest share stopped"
          },
          "400": {
            "description": "Version negotiation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersioningError"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session has ended"
          },
          "403": {
            "description": "The ingest share belongs to someone else"
          },
          "404": {
            "description": "Ingest share not found"
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ],
        "x-introduced-in-version": "1.0.0"
      }
    }
  },
  "components": {
    "schemas": {
      "APIAgentIdentity": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "hostname",
              "type"
            ],
            "properties": {
              "hostname": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Anonymous"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "agent_name",
              "resource_name",
              "type"
            ],
            "properties": {
              "agent_name": {
                "type": "string"
              },
              "resource_name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "AgentId"
                ]
              }
            }
          }
        ],
        "description": "The identity configured for this local agent."
      },
      "APICreateSessionRequest": {
        "type": "object",
        "description": "Create a new session in the given project\n(`project_name` is part of the URL)",
        "required": [
          "session"
        ],
        "properties": {
          "session": {
            "type": "string"
          }
        }
      },
      "APICreateSessionResponse": {
        "type": "object",
        "description": "Response when successfully creating a new session\nin a project",
        "required": [
          "project",
          "session"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "session": {
            "type": "string"
          }
        }
      },
      "APICreateShareResponse": {
        "type": "object",
        "description": "Response when successfully creating a new ingest share.",
        "required": [
          "share_id",
          "project",
          "session",
          "dest_path"
        ],
        "properties": {
          "dest_path": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "share_id": {
            "type": "string"
          }
        }
      },
      "APICurrentForegroundShare": {
        "oneOf": [
          {
            "type": "object",
            "description": "No foreground share is desired.",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "None"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A foreground share is desired, but it can't be used in the caller's login session (yet).",
            "required": [
              "share_id",
              "project",
              "session",
              "dest_path",
              "message",
              "type"
            ],
            "properties": {
              "created_by": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Login name of the user who started the share; null for shares from an smbdrop\nthat didn't record it yet"
              },
              "dest_path": {
                "type": "string",
                "description": "The path in the data management that is exported with this Share."
              },
              "message": {
                "type": "string",
                "description": "Why the share is unavailable, written for the person running the client."
              },
              "project": {
                "type": "string",
                "description": "Project derived from the share destination."
              },
              "session": {
                "type": "string",
                "description": "Session derived from the share destination."
              },
              "share_id": {
                "type": "string",
                "description": "Stable identifier used to close this share."
              },
              "type": {
                "type": "string",
                "enum": [
                  "Unavailable"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The foreground share is mounted; write here.",
            "required": [
              "share_id",
              "project",
              "session",
              "dest_path",
              "mount_path",
              "type"
            ],
            "properties": {
              "created_by": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Login name of the user who started the share; null for shares from an smbdrop\nthat didn't record it yet"
              },
              "dest_path": {
                "type": "string",
                "description": "The path in the data management that is exported with this Share"
              },
              "mount_path": {
                "type": "string",
                "description": "Where the share is mounted on the local system"
              },
              "project": {
                "type": "string",
                "description": "Project derived from the share destination."
              },
              "session": {
                "type": "string",
                "description": "Session derived from the share destination."
              },
              "share_id": {
                "type": "string",
                "description": "Stable identifier used to close this share."
              },
              "type": {
                "type": "string",
                "enum": [
                  "Mounted"
                ]
              }
            }
          }
        ],
        "description": "Local system users can ask the agent for the current foreground share. This\ndoesn't have to contain credentials, most important is some kind of identity\nand the path where the share is mounted."
      },
      "APIHealthCheckResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Ok"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "NotAvailable"
                ]
              }
            }
          }
        ],
        "description": "Health check API endpoint response"
      },
      "APIListProjectsResponse": {
        "type": "object",
        "description": "Response listing projects the current user has access to,\nwith the intent of creating a session or",
        "required": [
          "projects"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/APIProjectSummary"
            }
          }
        }
      },
      "APIListSessionsResponse": {
        "type": "object",
        "description": "Response listing existing sessions in the given project",
        "required": [
          "project",
          "sessions"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "session_summaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/APISessionSummary"
            },
            "description": "The same sessions with their last modification. Missing in answers of older agents."
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "APILoginRequest": {
        "type": "object",
        "description": "Sign in with the management interface's username and password",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "APILoginResponse": {
        "type": "object",
        "description": "Answer to a successful sign-in; the session itself travels in the `modama_agent_session`\ncookie",
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string"
          }
        }
      },
      "APIProjectSummary": {
        "type": "object",
        "required": [
          "name",
          "owner",
          "members",
          "modified_at"
        ],
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modified_at": {
            "type": "integer",
            "format": "int64",
            "description": "Last modification as an integer Unix timestamp."
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      },
      "APISessionSummary": {
        "type": "object",
        "description": "A session in a project",
        "required": [
          "name",
          "modified_at"
        ],
        "properties": {
          "modified_at": {
            "type": "integer",
            "format": "int64",
            "description": "Last modification of the session folder as an integer Unix timestamp."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "VersioningError": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "error",
              "supported",
              "header",
              "type"
            ],
            "properties": {
              "error": {
                "type": "string"
              },
              "header": {
                "type": "string"
              },
              "supported": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "unsupported_version"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error",
              "supported",
              "version",
              "header",
              "type"
            ],
            "properties": {
              "error": {
                "type": "string"
              },
              "header": {
                "type": "string"
              },
              "supported": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "invalid_version"
                ]
              },
              "version": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error",
              "supported",
              "header",
              "type"
            ],
            "properties": {
              "error": {
                "type": "string"
              },
              "header": {
                "type": "string"
              },
              "supported": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "missing_version"
                ]
              }
            }
          }
        ],
        "description": "Error response for version negotiation failures."
      }
    },
    "securitySchemes": {
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "modama_agent_session"
      }
    }
  }
}
