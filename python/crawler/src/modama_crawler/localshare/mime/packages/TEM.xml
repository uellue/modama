<?xml version="1.0"?>
<mime-info xmlns='http://www.freedesktop.org/standards/shared-mime-info'>

<!-- Module dimensionfile.c contains no magic. -->
<!-- From module dm3file.c -->
<mime-type type="application/x-dm3-tem">
  <comment>Digital Micrograph DM3 TEM data</comment>
  <glob pattern="*.dm3"/>
  <glob pattern="*.DM3"/>
</mime-type>

<mime-type type="application/x.stupid">
  <comment>Artificial collision on DM4</comment>
  <glob pattern="*.dm4"/>
  <glob pattern="*.DM4"/>
</mime-type>

<mime-type type="application/x-dm4-tem">
  <comment>Digital Micrograph DM4 TEM data</comment>
  <magic priority="80">
  <!-- AND is achieved by nesting <match/> tags, following
  /us/share/mime/packages/freedesktop.org.xml example? -->
    <match type="big32" offset="0" value="4">
      <match type="string" offset="54" value="%%%%"/>
    </match>
  </magic>
  <glob pattern="*.dm4"/>
  <glob pattern="*.DM4"/>
</mime-type>

<mime-type type="application/x.empad-raw">
  <comment>Raw binary data component of EMPAD datasets</comment>
  <glob pattern="scan*_x*_y*.raw" weight="80"/>
  <glob pattern="series*_x*.raw" weight="80"/>
  <glob pattern="SCAN*_X*_Y*.RAW" weight="80"/>
  <glob pattern="SERIES*_X*.RAW" weight="80"/>
</mime-type>

<mime-type type="application/x.empad+xml">
  <comment>XML metadata component of EMPAD datasets</comment>
  <match>
    <magic type="string" offset="0" value="&lt;root name=">
      <magic type="string" offset="85:285" value="&lt;software_version&gt;"/>
    </magic>
  </match>
  <glob pattern="*.xml"/>
  <glob pattern="*.XML"/>
</mime-type>

<!-- From module dmefile.c -->
<mime-type type="application/x-dme-spm">
  <comment>DME SPM data</comment>
  <magic priority="80">
    <match type="string" offset="0" value="RSCOPE"/>
  </magic>
</mime-type>

<!-- Module nsidfile.c contains no magic. -->
<!-- Module shilpsfile.c contains no magic. -->
</mime-info>
