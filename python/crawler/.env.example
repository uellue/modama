# Configuration for python -m modama_crawler
# Copy this file to .env and fill in your values

# OAI-PMH endpoint, as reported to harvesters
OAI_BASE_URL=http://localhost:7654/oai
OAI_ADMIN_EMAIL=admin@example.org
# Address `serve` listens on; 0.0.0.0 inside a container
#OAI_BIND=localhost

# Data root path - absolute path where files are stored
MODAMA_DATA_ROOT=/data

# Database name
MODAMA_CRAWLER_DB=modama_crawler

# PostgreSQL admin credentials
POSTGRES_ADMIN=postgres
POSTGRES_PASSWORD=your_password_here

# PostgreSQL server connection
POSTGRES_ADDRESS=localhost
POSTGRES_PORT=5432

# Worker processes for metadata extraction; default: the number of CPUs, at most 8
#MODAMA_CRAWLER_EXTRACT_WORKERS=4

# Start the EOSC warehouse's harvest of OAI_BASE_URL after every finished crawl
# (Airflow API; an account allowed to start DAG runs). Unset: no harvest is started.
#MODAMA_CRAWLER_AIRFLOW_URL=http://airflow-api-server:8080
#MODAMA_CRAWLER_AIRFLOW_USER=crawler
#MODAMA_CRAWLER_AIRFLOW_PASSWORD=your_password_here
