# The GPU path, in its own venv (fastembed-gpu and onnxruntime-gpu replace fastembed and onnxruntime; the two
# must not be installed together). onnxruntime-gpu has aarch64 Linux wheels on PyPI from 1.29.0 on, built for
# CUDA 13 (manylinux_2_34: glibc 2.34 or newer); 1.24.4, production's version, has none. The extras pull CUDA 13
# runtime, cuBLAS, cuFFT, cuRAND, NVRTC and cuDNN 9 as nvidia-* wheels; the NVIDIA driver must be 580 or newer.
# Checked 2026-11-13 with pip's resolver for manylinux aarch64, CPython 3.13.
# The CUDA libraries of CUDA 13.0, as onnxruntime-gpu 1.31.1 is built (onnxruntime/capi/
# build_and_package_info.py: cuda_version = '13.0'); its extras would allow any 13.x.
nvidia-cuda-runtime==13.0.*
nvidia-cuda-nvrtc==13.0.*
nvidia-nvjitlink==13.0.*
nvidia-cublas==13.0.*
nvidia-cufft==12.0.*
nvidia-curand==10.4.0.*
# The lock file requirements-gpu.txt (with hashes, for aarch64) is made from this one:
#   uv pip compile --no-build --generate-hashes --python-platform aarch64-manylinux_2_34 \
#     --python-version 3.11 requirements-gpu.in -o requirements-gpu.txt
# (the same packages for Python 3.11, 3.13 and 3.14; the hashes cover every file of a version)
fastembed-gpu==0.8.0
onnxruntime-gpu[cuda,cudnn]==1.31.1
tokenizers==0.22.2
numpy==2.4.4
huggingface-hub==1.8.0
