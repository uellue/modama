# modama-chain: a read-only warehouse role and an Airflow account in the Viewer role,
# both created by the init services
MODAMA_CHAIN_WAREHOUSE_DB=host=postgres dbname=datasetdb user=chain_reader password=test-chain-reader
MODAMA_CHAIN_AIRFLOW_USER=chain
MODAMA_CHAIN_AIRFLOW_PASSWORD=test-chain-viewer
