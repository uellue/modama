nvidia-cuda-nvrtc==13.0.*
nvidia-nvjitlink==13.0.*
nvidia-cublas==13.0.*
nvidia-cufft==12.0.*
nvidia-curand==10.4.0.*
fastembed-gpu==0.8.0
onnxruntime-gpu[cuda,cudnn]==1.31.1
tokenizers==0.22.2
numpy==2.4.4
huggingface-hub==1.8.0
