+// One character of text on one line, or a bracket pair around such text, the pairs
+// nested up to `depth` deep.
+const balancedBrackets = (depth: number): string =>
+    depth === 0 ? String.raw`[^()\n]` : String.raw`(?:[^()\n]|\(${balancedBrackets(depth - 1)}*\))`;
+
+// A link's address as CommonMark reads it: brackets in it only in balanced pairs, here
+// nested up to three deep, so "(…/SI+data+(20)/…)" is one address and "[a](u) (note)"
+// ends after "u". An address with an unbalanced bracket makes no link.
+export const LINK_ADDRESS = `${balancedBrackets(3)}+`;
+
 // The link forms MessageMarkdown renders: [label](url), also inside **bold**.
-const MARKDOWN_LINK = /\[(.+?)]\((.+?)\)/g;
+const MARKDOWN_LINK = new RegExp(String.raw`\[(.+?)]\((${LINK_ADDRESS})\)`, 'g');

