# devvm settings for this project; they override devvm's defaults.env, see its README.
# Commit this file. Optional companions in this folder: provision.sh (runs once in a
# new VM as the VM user) and commands.sh (project-specific devvm commands).

# VMs of this project are named <prefix><branch>
DEVVM_VM_PREFIX=data-management-system-

# Debian packages installed in the VM, besides devvm's defaults (git, curl, Docker).
# The services, the crawler included, run in Docker images; these are for working
# with them over SSH: the warehouse APIs (jq), long builds (tmux, htop), data (rsync)
DEVVM_PACKAGES="$DEVVM_PACKAGES jq tmux htop rsync"

# Sized for the whole stack at once with a few hundred data files, not for production:
# the modama test deployment (deploy/, about a dozen containers, Rust and Node builds),
# the EOSC warehouse (prototypes/EOSC-Data-Commons: OpenSearch and its dashboards,
# RabbitMQ, a Celery worker with the embedding model, PostgreSQL, pgAdmin, the search
# and tool services) and the crawler. OpenSearch alone wants about 2 GB; the builds
# want the cores. The disk holds the images, build caches and container volumes; it is
# thin-provisioned, so only used space costs on the host.
DEVVM_VCPUS=8
DEVVM_RAM_MB=24576
DEVVM_DISK_GB=120

# The tests, run by `devvm test [ARGS...]` in the checkout in the VM, with the ARGS
#DEVVM_TEST_COMMAND=./run-tests.sh
